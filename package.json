{
  "name": "inplux-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && next build && npm run check:output",
    "start": "next start",
    "lint": "eslint",
    "check:content": "node scripts/verify-public-content.mjs",
    "check:output": "node scripts/verify-build-output.mjs",
    "check:http": "node scripts/verify-http-contracts.mjs",
    "inspect:hero": "node scripts/inspect-hero-media.mjs",
    "test:hero-inspector": "node --test scripts/inspect-hero-media.test.mjs",
    "test:deck": "node --test scripts/verify-deck-model.test.mjs",
    "check": "npm run lint && npm run test:hero-inspector && npm run test:deck && npm run build && npm run check:http"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
