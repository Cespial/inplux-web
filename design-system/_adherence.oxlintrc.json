{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "ui_kits/marketing-website/**",
              "ui_kits/tribai/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|uppercase|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, uppercase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|soft|teal|ink|onDark)$/]",
        "message": "<Badge> variant must be one of 'outline' | 'soft' | 'teal' | 'ink' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|iconLeft|iconRight|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, iconLeft, iconRight, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|teal|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'teal' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|padding|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: hover, padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onDark|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: items, onDark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|basePath|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|horizontal-inverse|horizontal-mono|horizontal-mono-white|stacked|stacked-inverse|wordmark-ink|wordmark-white|mark-teal|mark-ink|mark-white|mark-flux|appicon)$/]",
        "message": "<Logo> variant must be one of 'horizontal' | 'horizontal-inverse' | 'horizontal-mono' | 'horizontal-mono-white' | 'stacked' | 'stacked-inverse' | 'wordmark-ink' | 'wordmark-white' | 'mark-teal' | 'mark-ink' | 'mark-white' | 'mark-flux' | 'appicon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarkAnimated'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|mode|tile|onDark|key|ref|className|style|children)$/]",
        "message": "<MarkAnimated> doesn't accept that prop. Declared props: size, mode, tile, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarkAnimated'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:enter|loading)$/]",
        "message": "<MarkAnimated> mode must be one of 'enter' | 'loading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrbitGraphic'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|sublabel|onDark|animate|key|ref|className|style|children)$/]",
        "message": "<OrbitGraphic> doesn't accept that prop. Declared props: size, label, sublabel, onDark, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:figure|label|onDark|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: figure, label, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|accent|onDark|align|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, accent, onDark, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Stat> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
